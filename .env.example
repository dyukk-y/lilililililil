# Шаблон переменных окружения. Скопируйте в .env (он в .gitignore) или
# задайте эти же переменные в панели хостинга. Пустые/закомментированные
# значения берутся по умолчанию.
#
# ВАЖНО: после первого запуска большинство настроек хранится в БД и
# меняется из админ-панели (⚙️ Настройки). Правка .env для уже сохранённых
# ключей на них больше не влияет — кроме ADMINS, который всегда берётся отсюда.

# ================== ОБЯЗАТЕЛЬНЫЕ ==================
BOT_TOKEN=123456789:replace-with-your-token
MAIN_CHANNEL_ID=-1001234567890
# Telegram ID администраторов через запятую
ADMINS=111111111,222222222

# ================== ЧАТЫ И ТЕМЫ ==================
COMMENTS_CHAT_ID=
MODERATORS_CHAT_ID=
MODERATORS_TOPIC_ID=
ADMINS_CHAT_ID=
ADMINS_TOPIC_ID=
# Тема в чате администраторов для уведомлений о пожертвованиях (0 — без темы)
DONATION_TOPIC_ID=0

# ================== РОЛИ ==================
# Подмножество ADMINS: редактирование настроек и выгрузка пользователей
SUPER_ADMINS=
# Кто рассматривает заявки на удаление чужих постов
DELETION_REVIEWERS=

# ================== ХРАНЕНИЕ ==================
DB_NAME=/app/data/smotrbot.db
BACKUP_DIR=/app/data/backups
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP_LAST=48
# По умолчанию лог пишется рядом с базой: /app/data/bot.log (с ротацией)
# LOG_FILE=/app/data/bot.log
# LOG_LEVEL=INFO

# ================== ПУБЛИКАЦИЯ ==================
PUBLISH_TIMEZONE=Asia/Novosibirsk
PUBLISH_WINDOW_START_HOUR=8
PUBLISH_WINDOW_END_HOUR=23
PUBLISH_WINDOW_END_MINUTE=59
DAILY_PUBLISH_LIMIT=10
USER_DAILY_POST_LIMIT=5
MAX_POST_LENGTH=100
MIN_SLOT_GAP_MINUTES=20

# ================== АВТОМОДЕРАЦИЯ ==================
DUPLICATE_REPEAT_LIMIT=5
DUPLICATE_SIMILARITY_THRESHOLD=0.87
DUPLICATE_LOOKBACK_HOURS=72
PHOTO_DUPLICATE_LOOKBACK_HOURS=72
NSFW_EXPLICIT_THRESHOLD=0.65
AI_SHADOW_MODE=false
MODERATION_TIMEOUT_HOURS=24
DELETION_REQUEST_TIMEOUT_HOURS=24

# ================== ЦЕНЫ (Telegram Stars) ==================
AUTHOR_LOOKUP_PRICE_STARS=100
PRIORITY_BOOST_PRICE_STARS=50
UNLOCK_PRICE_STARS=50

# ================== ПЕРВЫЙ КОММЕНТАРИЙ ПОД ПОСТОМ ==================
# INTRO_COMMENT_TEXT=🤝 Будьте вежливы друг к другу!
# INTRO_COMMENT_BTN1_LABEL=✍️ Предложить пост
# INTRO_COMMENT_BTN1_URL=https://t.me/your_bot
# INTRO_COMMENT_BTN2_LABEL=⭐ Звёзды
# INTRO_COMMENT_BTN2_URL=https://t.me/...
# INTRO_COMMENT_BTN3_LABEL=🛡 VPN
# INTRO_COMMENT_BTN3_URL=https://t.me/...

# ================== ПРОЧЕЕ ==================
# true — выбрасывать накопившиеся за время простоя обновления при старте
# (старое поведение; по умолчанию false, чтобы не терять оплаты).
DROP_PENDING_UPDATES=false

# ================== ОБСЛУЖИВАНИЕ (тариф 1 ГБ RAM / 5 ГБ диска) ==================
# Выгружать NudeNet из памяти после N секунд без фото (при LOW_MEMORY_MODE=true)
LOW_MEMORY_MODE=true
NUDENET_IDLE_UNLOAD_SECONDS=600
# Сколько дней хранить журнал действий в БД
LOG_RETENTION_DAYS=90
# Максимальный суммарный объём резервных копий, МБ
BACKUP_MAX_TOTAL_MB=1024
